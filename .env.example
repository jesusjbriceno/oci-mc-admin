# Cloudflare Zero Trust — Team Domain
# Se encuentra en Cloudflare Zero Trust → Settings → Team Domain
CF_TEAM_DOMAIN=

# Cloudflare Access — Application Audience (AUD)
# Se encuentra en Zero Trust → Access → Applications → <tu-app> → Application Audience (AUD)
# Opcional si solo validas por email
CF_APP_AUD=

# Emails permitidos (separados por coma)
# Ejemplo: jesus@example.com,javi@example.com
ALLOWED_EMAILS=jesusjbm@gmail.com
